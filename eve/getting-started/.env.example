# Copy to .env.local and fill in. Eve loads .env / .env.local automatically.

# RunPod API key — used for BOTH the self-deployed LLM "brain" and the
# image-generation tool. Get one at https://console.runpod.io/user/settings
RUNPOD_API_KEY=

# HuggingFace token — the vLLM worker uses it to pull the model.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# The self-deployed vLLM endpoint id (you create this with runpodctl — see AGENTS.md).
# Leave blank until you've deployed it.
RUNPOD_LLM_ENDPOINT_ID=

# The model id your agent requests. Must match the served model name on the
# endpoint (see the OPENAI_SERVED_MODEL_NAME_OVERRIDE note in AGENTS.md).
RUNPOD_LLM_MODEL=Qwen/Qwen3.6-27B-FP8
